[gd_resource type="Resource" script_class="EventDefinition" load_steps=4 format=3]

[ext_resource type="Script" path="res://scripts/events/event_definition.gd" id="1_definition"]
[ext_resource type="Script" path="res://scripts/events/event_choice.gd" id="2_choice"]
[ext_resource type="Script" path="res://scripts/events/event_effect.gd" id="3_effect"]

[sub_resource type="Resource" id="Effect_returned"]
script = ExtResource("3_effect")
target = &"flags.outsiders_returned"
operation = 1
value = true

[sub_resource type="Resource" id="Choice_acknowledge"]
script = ExtResource("2_choice")
choice_id = &"ACKNOWLEDGE_RETURN"
label = "Acknowledge them (test)"
description = "Test-only follow-up resolution."
effects = Array[ExtResource("3_effect")]([SubResource("Effect_returned")])

[resource]
script = ExtResource("1_definition")
event_id = &"EVT_TEST_OUTSIDERS_RETURN"
title = "Outsiders return (test)"
body_text = "Scheduled-only functional test event; not final narrative writing."
tags = PackedStringArray("test", "outsiders", "followup")
priority = 4
trigger_mode = 1
choices = Array[ExtResource("2_choice")]([SubResource("Choice_acknowledge")])
participants = PackedStringArray("outsiders")
memory_tags = PackedStringArray("test_outsiders_returned")
