[gd_scene format=3]

[ext_resource type="Script" path="res://scripts/ui/debug_hud.gd" id="1"]

[node name="DebugHUD" type="CanvasLayer" groups=["debug_hud"]]
script = ExtResource("1")

[node name="Panel" type="PanelContainer" parent="."]
offset_left = 8.0
offset_top = 8.0
self_modulate = Color(1, 1, 1, 0.85)

[node name="Margin" type="MarginContainer" parent="Panel"]
theme_override_constants/margin_left = 10
theme_override_constants/margin_top = 8
theme_override_constants/margin_right = 10
theme_override_constants/margin_bottom = 8

[node name="VBox" type="VBoxContainer" parent="Panel/Margin"]
theme_override_constants/separation = 6

[node name="InfoLabel" type="Label" parent="Panel/Margin/VBox"]
theme_override_font_sizes/font_size = 14
text = "PRIMALIS - STEP 5"

[node name="FeedButton" type="Button" parent="Panel/Margin/VBox"]
visible = false
theme_override_font_sizes/font_size = 14
text = "FEED PRIMALIS - 3 FOOD"

[node name="AssignForagerButton" type="Button" parent="Panel/Margin/VBox"]
visible = false
theme_override_font_sizes/font_size = 14
text = "ASSIGN FORAGER"

[node name="AssignWoodcutterButton" type="Button" parent="Panel/Margin/VBox"]
visible = false
theme_override_font_sizes/font_size = 14
text = "ASSIGN WOODCUTTER"

[node name="AssignBuilderButton" type="Button" parent="Panel/Margin/VBox"]
visible = false
theme_override_font_sizes/font_size = 14
text = "ASSIGN BUILDER"

[node name="BuildLabel" type="Label" parent="Panel/Margin/VBox"]
visible = false
theme_override_font_sizes/font_size = 14
text = "BUILD"

[node name="PlaceStorehouseButton" type="Button" parent="Panel/Margin/VBox"]
visible = false
theme_override_font_sizes/font_size = 14
text = "PLACE STOREHOUSE - 8 TIMBER"

[node name="PlaceHouseButton" type="Button" parent="Panel/Margin/VBox"]
visible = false
theme_override_font_sizes/font_size = 14
text = "PLACE HOUSE - 6 TIMBER"
